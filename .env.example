# DeepSeek V4 Pro（兼容 OpenAI Chat Completions）。
# 不要把真实密钥提交到 Git。

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# standard：单专家低延迟；expert：允许跨领域请求并行调用多个专家。
AGENT_MODE=standard
AGENT_MAX_STEPS=5
DAG_MAX_NODES=10
DAG_MAX_PARALLEL_READS=3
DAG_READ_RETRIES=1
DAG_NODE_TIMEOUT_SECONDS=30
AGENT_MAX_ROUNDS=3
AGENT_MAX_MODEL_CALLS=12
AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_PARALLELISM=3

# 可选：为不同角色覆盖默认模型。
# LLM_SUPERVISOR_MODEL=deepseek-v4-flash
# LLM_PLANNER_MODEL=deepseek-v4-pro
# LLM_ACCOUNT_MODEL=deepseek-v4-pro
# LLM_OPERATIONS_MODEL=deepseek-v4-pro
# LLM_INVESTMENT_MODEL=deepseek-v4-pro
# LLM_GENERAL_MODEL=deepseek-v4-flash
# LLM_AGGREGATOR_MODEL=deepseek-v4-pro

# Claude 原生 API 使用 Messages 格式，当前适配器尚不能直接使用。
# 后续需增加 AnthropicModel，不能只修改 LLM_BASE_URL。

# Mock Bank
BANK_BASE_URL=http://127.0.0.1:8000
BANK_API_TOKEN=
BANK_USER_ID=U4

# Mock Bank 用户门户。公网部署时必须同时使用 HTTPS。
MOCK_BANK_2FA_ENABLED=true
MOCK_BANK_SECURE_COOKIE=false

# WebRTC 语音原型。ASR 服务需兼容 OpenAI /audio/transcriptions；
# Qwen3-ASR 可使用 qwen-asr-serve 或兼容的 vLLM 服务部署。
VOICE_ASR_BASE_URL=http://127.0.0.1:8094/v1
VOICE_ASR_API_KEY=EMPTY
VOICE_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
VOICE_HOST=127.0.0.1
VOICE_PORT=8090
VOICE_SILENCE_MS=700
VOICE_MIN_SPEECH_MS=300
VOICE_RMS_THRESHOLD=500
